#!/bin/bash
# Boot script for the application host: Docker and the working folder. The services are deployed onto it
# later by the pipeline (Ansible over Session Manager), not by this script. Log: /var/log/mls-bootstrap.log
set -euxo pipefail
exec > >(tee -a /var/log/mls-bootstrap.log) 2>&1
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y --no-install-recommends ca-certificates curl unzip jq git docker.io docker-compose-v2 python3-venv
systemctl enable --now docker

# Containers keep their data under one folder, easy to back up and to find.
install -d -m 0750 /opt/mls

# AWS CLI v2 (Ubuntu has no awscli package): the deploy fetches jars from S3 with the host's own role.
if ! command -v aws >/dev/null 2>&1; then
  cd /tmp
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o awscliv2.zip
  unzip -q -o awscliv2.zip
  ./aws/install --update
  rm -rf awscliv2.zip aws
  cd /
fi

touch /var/lib/mls-bootstrap-done
echo "mls application host bootstrap finished"

