{
  "QueryLanguage": "JSONata",
  "StartAt": "A",
  "States": {
    "A": {
      "Type": "Pass",
      "Assign": {
        "cfg": "{% $lookup(${configurations_json}, 'ubuntu24-pg16') %}",
        "subnets": "{% ${subnet_ids_json} %}",
        "sg": "${security_group_id}",
        "profile": "${instance_profile_name}",
        "publicIp": "{% ${associate_public_ip} %}",
        "env": "${environment}",
        "defaultTtl": "{% ${default_ttl_hours} %}",
        "maxTtl": "{% ${max_ttl_hours} %}"
      },
      "End": true
    }
  }
}
