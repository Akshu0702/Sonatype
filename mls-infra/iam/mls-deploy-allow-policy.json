{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2InMumbaiOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "autoscaling:Describe*",
        "elasticloadbalancing:Describe*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "RegionalServicesByNamePrefix",
      "Effect": "Allow",
      "Action": [
        "eks:*"
      ],
      "Resource": "arn:aws:eks:ap-south-1:096631344162:*/mls-*"
    },
    {
      "Sid": "EksCreateAndList",
      "Effect": "Allow",
      "Action": [
        "eks:CreateCluster",
        "eks:ListClusters",
        "eks:Describe*",
        "eks:CreateNodegroup",
        "eks:CreateAddon",
        "eks:CreateAccessEntry",
        "eks:TagResource",
        "eks:DescribeAddonVersions"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "RdsByPrefix",
      "Effect": "Allow",
      "Action": [
        "rds:*"
      ],
      "Resource": [
        "arn:aws:rds:ap-south-1:096631344162:db:mls-*",
        "arn:aws:rds:ap-south-1:096631344162:subnet-group:mls-*",
        "arn:aws:rds:ap-south-1:096631344162:pg:mls-*",
        "arn:aws:rds:ap-south-1:096631344162:og:mls-*"
      ]
    },
    {
      "Sid": "RdsDescribe",
      "Effect": "Allow",
      "Action": [
        "rds:Describe*",
        "rds:ListTagsForResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "KmsInMumbai",
      "Effect": "Allow",
      "Action": [
        "kms:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "SecretsByPrefix",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:*"
      ],
      "Resource": "arn:aws:secretsmanager:ap-south-1:096631344162:secret:mls-*"
    },
    {
      "Sid": "SecretsList",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:ListSecrets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "S3ByPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:aws:s3:::mls-*",
        "arn:aws:s3:::mls-*/*"
      ]
    },
    {
      "Sid": "S3List",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DynamoDbByPrefix",
      "Effect": "Allow",
      "Action": [
        "dynamodb:*"
      ],
      "Resource": "arn:aws:dynamodb:ap-south-1:096631344162:table/mls-*"
    },
    {
      "Sid": "LogsAndAlarmsByPrefix",
      "Effect": "Allow",
      "Action": [
        "logs:*",
        "cloudwatch:*",
        "sns:*"
      ],
      "Resource": [
        "arn:aws:logs:ap-south-1:096631344162:log-group:*mls-*",
        "arn:aws:cloudwatch:ap-south-1:096631344162:alarm:mls-*",
        "arn:aws:sns:ap-south-1:096631344162:mls-*"
      ]
    },
    {
      "Sid": "LogsAndMonitoringDescribe",
      "Effect": "Allow",
      "Action": [
        "logs:Describe*",
        "logs:ListTagsForResource",
        "logs:CreateLogGroup",
        "logs:TagResource",
        "cloudwatch:Describe*",
        "sns:ListTopics",
        "sns:CreateTopic"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "Route53ResolverInMumbai",
      "Effect": "Allow",
      "Action": [
        "route53resolver:*",
        "route53:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "IamRolesAndPoliciesByPrefix",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:TagPolicy",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::096631344162:role/mls-*",
        "arn:aws:iam::096631344162:policy/mls-*"
      ]
    },
    {
      "Sid": "IamAttachOnlyApprovedPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::096631344162:role/mls-*",
      "Condition": {
        "ArnLike": {
          "iam:PolicyARN": [
            "arn:aws:iam::096631344162:policy/mls-*",
            "arn:aws:iam::aws:policy/AmazonEKSWorkerNodePolicy",
            "arn:aws:iam::aws:policy/AmazonEKS_CNI_Policy",
            "arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly",
            "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore",
            "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy",
            "arn:aws:iam::aws:policy/service-role/AmazonEBSCSIDriverPolicy"
          ]
        }
      }
    },
    {
      "Sid": "IamOidcProvidersCreateOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider",
        "iam:TagOpenIDConnectProvider",
        "iam:DeleteOpenIDConnectProvider"
      ],
      "Resource": "arn:aws:iam::096631344162:oidc-provider/oidc.eks.ap-south-1.amazonaws.com/id/*"
    },
    {
      "Sid": "ServiceLinkedRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "eks.amazonaws.com",
            "eks-nodegroup.amazonaws.com",
            "autoscaling.amazonaws.com",
            "rds.amazonaws.com",
            "elasticloadbalancing.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "IdentityAndReadHelpers",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "iam:ListAccountAliases"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InstanceProfilesByPrefix",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile"
      ],
      "Resource": "arn:aws:iam::096631344162:instance-profile/mls-*"
    },
    {
      "Sid": "SchedulesByPrefix",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule",
        "scheduler:GetSchedule",
        "scheduler:TagResource",
        "scheduler:UntagResource",
        "scheduler:ListTagsForResource"
      ],
      "Resource": "arn:aws:scheduler:ap-south-1:096631344162:schedule/default/mls-*"
    },
    {
      "Sid": "SchedulesList",
      "Effect": "Allow",
      "Action": [
        "scheduler:ListSchedules"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    }
  ]
}